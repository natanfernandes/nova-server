generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String   @id @default(uuid())
  name      String
  x         Float    @default(0)
  y         Float    @default(0)
  z         Float    @default(0)
  hp        Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
